{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/ui",
  "rewrites": [{ "source": "/:p*", "destination": "/api/handler?__p=:p*" }],
  "functions": {
    "api/handler.ts": { "includeFiles": "dist/ui/view.html", "maxDuration": 60 }
  }
}
