# Zoho Books, Self Client from https://api-console.zoho.com (read-only scopes only):
# ZohoBooks.invoices.READ,ZohoBooks.customerpayments.READ,ZohoBooks.vendorpayments.READ,ZohoBooks.expenses.READ,
# ZohoBooks.banking.READ,ZohoBooks.estimates.READ,ZohoBooks.contacts.READ,ZohoBooks.settings.READ
# Leave these empty for sample data. Other names also work: ZOHO_ORG_ID, ZOHO_ORGANIZATION_ID, ZOHO_ACCOUNTS_URL, ZOHO_REGION.
ZOHO_DC=com            # com | in | eu | com.au | jp | ca | com.cn | sa  (or a URL like https://accounts.zoho.in)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_BOOKS_ORG_ID=

# Zoho Books has no targets: monthly collections target in dollars, for the collections_vs_target chart
ZOHO_COLLECTIONS_MONTHLY_TARGET=

# Set to "sample" to ignore the Zoho settings above and use sample data (the smoke test does this)
# CASHFLOW_DATA=sample

# HTTP entries (npm run web, Vercel): MCP at /mcp behind OAuth.
# Sign-in password typed on the connect page, 12+ characters. Changing it signs everyone out.
CASHFLOW_PASSWORD=
# Signs codes and tokens, 32+ characters; npm run web makes one on first run. Changing it signs everyone out.
# CASHFLOW_AUTH_SECRET=
# Only if the Host header is not the public address, e.g. https://cash.example.com
# CASHFLOW_PUBLIC_URL=
